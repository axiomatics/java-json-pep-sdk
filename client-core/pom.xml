<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.xacml</groupId>
        <artifactId>json-pep-sdk</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>json-pep-sdk-client-core</artifactId>
    <name>client-core</name>
    <dependencies>
        <dependency>
            <groupId>io.xacml</groupId>
            <artifactId>json-pep-sdk-models</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Publishes the test utilities (e.g. StubPdp) for the client modules' test suites. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
